# ============================================
# متغيرات البيئة المطلوبة لنشر المشروع على Vercel
# ============================================

# ===== Supabase PostgreSQL =====
# احصل عليه من: Supabase Dashboard → Settings → Database → Connection string → URI

# اتصال مجمّع - Transaction mode (للاستعلامات - منفذ 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# اتصال مباشر - Session mode (للترحيلات - منفذ 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ===== Cloudinary (لرفع الملفات والصور) =====
# احصل عليه من: Cloudinary Dashboard → Account Details
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
