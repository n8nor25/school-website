generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SliderImage {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("تعليم")
  imageUrl  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsItem {
  id        String   @id @default(cuid())
  title     String
  content   String?
  category  String   @default("عام")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  duration    String   @default("00:00")
  thumbnail   String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Schedule {
  id          String   @id @default(cuid())
  title       String
  grade       String   @default("عام")
  fileUrl     String
  type        String   @default("حالي")
  uploadDate  String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== المرحلة الأولى: أدوات الإدارة =====

model ClassRoom {
  id          String    @id @default(cuid())
  name        String    // e.g. "الصف الأول الأزهر"
  grade       String    // e.g. "أولى"
  section     String    @default("أ") // أ، ب، ج
  academicYear String   @default("2024/2025")
  students    Student[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subject {
  id        String   @id @default(cuid())
  name      String   // e.g. "الرياضيات"
  grades    Grade[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id          String      @id @default(cuid())
  name        String
  nationalId  String?     @unique
  classRoomId String
  classRoom   ClassRoom   @relation(fields: [classRoomId], references: [id])
  parentId    String?
  parent      Parent?     @relation(fields: [parentId], references: [id])
  phone       String?
  address     String?
  birthDate   String?
  enrollDate  String?
  status      String      @default("نشط") // نشط، متوقف، منقول
  attendance  Attendance[]
  grades      Grade[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Parent {
  id        String         @id @default(cuid())
  name      String
  phone     String
  email     String?
  relation  String         @default("أب") // أب، أم، ولي
  students  Student[]
  messages  ParentMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  date      String   // YYYY-MM-DD
  status    String   // حاضر، غائب، متأخر، إذن
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  examType  String   // شهري، نصفي، نهائي، اختبار قصير
  score     Float
  maxScore  Float    @default(100)
  term      String   @default("الفصل الأول")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParentMessage {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id])
  studentId String?
  subject   String
  message   String
  type      String   @default("إشعار") // إشعار، تحذير، غياب، نتائج
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
