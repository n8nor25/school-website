generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("school_admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SliderImage {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("تعليم")
  imageUrl  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsItem {
  id        String   @id @default(cuid())
  title     String
  content   String?
  category  String   @default("عام")
  active    Boolean  @default(true)
  archived  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  duration    String   @default("00:00")
  thumbnail   String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Schedule {
  id          String   @id @default(cuid())
  title       String
  grade       String   @default("عام")
  fileUrl     String
  type        String   @default("حالي")
  uploadDate  String
  active      Boolean  @default(true)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== المرحلة الأولى: أدوات الإدارة =====

model ClassRoom {
  id           String    @id @default(cuid())
  name         String
  grade        String
  section      String    @default("أ")
  academicYear String    @default("2024/2025")
  students     Student[]
  materials    EducationalMaterial[]
  homeworks    Homework[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  grades    Grade[]
  materials EducationalMaterial[]
  homeworks Homework[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id          String      @id @default(cuid())
  name        String
  nationalId  String?     @unique
  classRoomId String
  classRoom   ClassRoom   @relation(fields: [classRoomId], references: [id])
  parentId    String?
  parent      Parent?     @relation(fields: [parentId], references: [id])
  phone       String?
  address     String?
  birthDate   String?
  enrollDate  String?
  status      String      @default("نشط")
  attendance  Attendance[]
  grades      Grade[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Parent {
  id        String         @id @default(cuid())
  name      String
  phone     String
  email     String?
  relation  String         @default("أب")
  students  Student[]
  messages  ParentMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  date      String
  status    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  examType  String
  score     Float
  maxScore  Float    @default(100)
  term      String   @default("الفصل الأول")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParentMessage {
  id        String   @id @default(cuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id])
  studentId String?
  subject   String
  message   String
  type      String   @default("إشعار")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== أدوات المعلم =====

model EducationalMaterial {
  id          String    @id @default(cuid())
  title       String
  description String?
  fileType    String
  fileUrl     String
  fileName    String
  fileSize    Int       @default(0)
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  classRoomId String?
  classRoom   ClassRoom? @relation(fields: [classRoomId], references: [id])
  notes       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Homework {
  id          String    @id @default(cuid())
  title       String
  description String
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  classRoomId String
  classRoom   ClassRoom @relation(fields: [classRoomId], references: [id])
  dueDate     String
  attachments String?
  notes       String?
  status      String    @default("نشط")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ===== نظام النتائج =====

model ExamResultGrade {
  id        String       @id @default(cuid())
  gradeName String
  updatedAt DateTime     @default(now())
  results   ExamResult[]
}

model ExamResult {
  id          String          @id @default(cuid())
  gradeId     String
  grade       ExamResultGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  seatNumber  String
  studentName String
  arabic      Float           @default(0)
  english     Float           @default(0)
  social      Float           @default(0)
  math        Float           @default(0)
  science     Float           @default(0)
  total       Float           @default(0)
  religion    Float           @default(0)
  art         Float           @default(0)
  computer    Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}
